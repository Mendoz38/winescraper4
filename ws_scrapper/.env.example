PORT=3001
USERS={"user1":"password1","user2":"password2"}

BROWSER_EXEC=/usr/bin/chromium-browser

# Nombre de requêtes en parallèle (workers)
SCRAPE_CONCURRENCY=3

# Délai minimum entre 2 requêtes, tous workers confondus (throttle global)
SCRAPE_PAGE_DELAY_MS=2000

# Retry sur une page qui semble vide (pas d'articles trouvés, sans erreur HTTP explicite)
SCRAPE_PAGE_RETRY_ATTEMPTS=3
SCRAPE_PAGE_RETRY_DELAY_MS=3000

# Retry pour le mode "easy" (axios) uniquement, en cas de 429
SCRAPE_EASY_RETRY_ATTEMPTS=3
SCRAPE_EASY_RETRY_DELAY_MS=5000
SCRAPE_RATE_LIMIT_MAX_DELAY_MS=15000

WS_BACK_BASE_URL="http://localhost:5000"